{
  "name": "nws-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "test:e2e": "playwright test",
    "test:e2e:live": "LIVE=1 playwright test --project=live",
    "typecheck": "tsc --noEmit",
    "record-fixtures": "node scripts/record-fixtures.ts"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "lit-html": "^3.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
